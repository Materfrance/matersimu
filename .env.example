# Copier ce fichier en .env et compléter.

# API PVGIS (laisser vide pour la valeur par défaut v5_3)
PVGIS_BASE_URL=

# Envoi des e-mails (SMTP). Sans SMTP_HOST + MAIL_FROM, l'envoi par mail est désactivé.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=simulation@materfrance.fr
SMTP_PASS=
MAIL_FROM="MaterFrance <simulation@materfrance.fr>"

# Optionnel : copie cachée de chaque étude envoyée (suivi des leads sans base de données)
MAIL_BCC=
